{
  "name": "create-median-app",
  "version": "1.0.0",
  "description": "Create a Next.js or TanStack Start website powered by Median CMS",
  "keywords": [
    "median",
    "mediancms",
    "cms",
    "nextjs",
    "tanstack",
    "create-app"
  ],
  "private": false,
  "type": "module",
  "bin": {
    "create-median-app": "src/index.ts",
    "create-median-next": "src/index.ts",
    "create-median-tanstack": "src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun",
    "dev": "bun run src/index.ts test-app --no-git"
  },
  "dependencies": {
    "picocolors": "^1.0.1"
  },
  "devDependencies": {
    "bun-types": "latest",
    "typescript": "^5.0.0"
  }
}
